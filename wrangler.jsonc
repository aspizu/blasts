{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "blasts",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-18",
    "secrets": {
        "required": ["AUTH_USERNAME", "AUTH_PASSWORD"],
    },
    "routes": [
        {
            "pattern": "blasts.aspiz.uk",
            "custom_domain": true,
        },
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "blasts",
        },
    ],
    "ratelimits": [
        {
            "name": "READ_RATELIMIT",
            "namespace_id": "962987432",
            "simple": {
                "limit": 120,
                "period": 60,
            },
        },
        {
            "name": "AUTH_RATELIMIT",
            "namespace_id": "962987433",
            "simple": {
                "limit": 10,
                "period": 60,
            },
        },
    ],
}
