{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "blasts",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-18",
    "assets": {
        "directory": "./public",
    },
    "secrets": {
        "required": ["AUTH_USERNAME", "AUTH_PASSWORD", "FEED_TITLE"],
    },
    "routes": [
        {
            "pattern": "blasts.aspiz.uk",
            "custom_domain": true,
        },
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "blasts",
        },
    ],
    "ratelimits": [
        {
            "name": "RATELIMIT",
            "namespace_id": "962987432",
            "simple": {
                "limit": 120,
                "period": 60,
            },
        },
    ],
}
